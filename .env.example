# OceanLife — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# NUNCA coloque valores reais neste arquivo: ele é versionado no Git.

# URL do projeto Supabase (pública; pode ir ao navegador).
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do Supabase (pode ir ao navegador; o acesso é limitado pela RLS).
# Use o nome e o formato que o painel do Supabase oferecer na configuração
# (chave "publishable" ou a antiga "anon"). Será ajustado na fase 03.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Decisão D2: a chave de serviço NÃO é usada no MVP. Todas as operações
# passam pela sessão do usuário e pela RLS. Não adicione a chave de serviço
# aqui nem na Vercel sem uma decisão registrada em docs/decisoes.md.
